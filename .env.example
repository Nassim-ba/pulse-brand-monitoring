# Claude API (https://console.anthropic.com). Ohne Schlüssel läuft Pulse im regelbasierten Modus.
ANTHROPIC_API_KEY=
# Nur nötig, wenn der Schlüssel keinem Workspace zugeordnet ist
ANTHROPIC_WORKSPACE_ID=
# Optional, Standard ist claude-haiku-4-5
ANTHROPIC_MODEL=
# Postgres (z. B. Neon über den Vercel Marketplace). Ohne URL nutzt Pulse den Arbeitsspeicher.
DATABASE_URL=
